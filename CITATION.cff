    given-names: "Dae Yun"
    orcid: https://orcid.org/0009-0004-0432-4675
repository-code: "https://github.com/jdaeyun/reflexive-thematic-analysis-canvas"
license: MIT
date-released: "2026-11-15"
keywords:
